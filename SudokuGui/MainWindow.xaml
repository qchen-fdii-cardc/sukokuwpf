<Window x:Class="SudokuGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sudoku GUI"
        Width="980"
        Height="760"
        MinWidth="920"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="#F7F7FA"
          Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="14"
                CornerRadius="10"
                BorderBrush="#D6D6DE"
                BorderThickness="1"
                Background="White">
            <Grid x:Name="BoardGrid"/>
        </Border>

        <StackPanel Grid.Column="1"
                    Margin="12,0,0,0">
            <TextBlock Text="Difficulty"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <ComboBox x:Name="DifficultyComboBox"
                      SelectedIndex="3"
                      Margin="20,0,20,14"
                      SelectionChanged="DifficultyComboBox_SelectionChanged">
                <ComboBoxItem Content="Easy"/>
                <ComboBoxItem Content="Medium"/>
                <ComboBoxItem Content="Hard"/>
                <ComboBoxItem Content="Expert"/>
            </ComboBox>

            <TextBlock Text="Number Pad"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <WrapPanel x:Name="NumberPadPanel"
                       HorizontalAlignment="Center"
                       Width="200"
                       Margin="0,0,0,12"/>

            <Button Content="New Puzzle"
                    Height="40"
                    Margin="20,0,20,8"
                    Click="NewPuzzleButton_Click"/>

            <UniformGrid Columns="2"
                         Margin="20,0,20,0">
                <Button Content="Clear"
                        Height="40"
                        Margin="0,0,6,8"
                        Click="ClearButton_Click"/>
                <Button Content="Undo"
                        Height="40"
                        Margin="6,0,0,8"
                        Click="UndoButton_Click"/>

                <Button Content="Redo"
                        Height="40"
                        Margin="0,0,6,8"
                        Click="RedoButton_Click"/>
                <Button Content="Save"
                        Height="40"
                        Margin="6,0,0,8"
                        Click="SaveButton_Click"/>

                <Button Content="Load"
                        Height="40"
                        Margin="0,0,6,8"
                        Click="LoadButton_Click"/>
                <Button Content="Snap"
                        Height="40"
                        Margin="6,0,0,8"
                        Click="SnapButton_Click"/>

                <Button Content="Restore Snap"
                        Height="40"
                        Margin="0,0,6,8"
                        Click="RestoreSnapButton_Click"/>
                <Button Content="Show/Hide Candidates"
                        Height="40"
                        Margin="6,0,0,8"
                        Click="ShowCandidatesToggleButton_Click"/>
            </UniformGrid>

            <CheckBox x:Name="ShowCandidatesCheckBox"
                      Content="Show Candidates"
                      IsChecked="True"
                      Visibility="Collapsed"
                      Checked="ShowCandidatesCheckBox_Changed"
                      Unchecked="ShowCandidatesCheckBox_Changed"/>

            <TextBlock Text="Click an empty cell, then type 1-9 or use the round buttons."
                       TextWrapping="Wrap"
                       Margin="18,16,18,0"
                       Foreground="#585866"
                       FontSize="13"/>

            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready"
                       TextWrapping="Wrap"
                       Margin="18,12,18,0"
                       Foreground="#2E4E80"
                       FontSize="13"
                       FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
